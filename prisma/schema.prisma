generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                                   String                @id @default(cuid())
  username                                             String                @unique
  email                                                String?               @unique
  name                                                 String?
  passwordHash                                         String?
  image                                                String?
  emailVerified                                        DateTime?
  dateOfBirth                                          DateTime?
  zodiacSign                                           String?
  chineseZodiac                                        String?
  createdAt                                            DateTime              @default(now())
  updatedAt                                            DateTime              @updatedAt
  coupleId                                             String?
  cityId                                               String?
  pushEnabled                                          Boolean               @default(false)
  emailEnabled                                         Boolean               @default(true)
  weeklyPulseReminder                                  Boolean               @default(true)
  challengeReminder                                    Boolean               @default(true)
  AIConversation                                       AIConversation[]
  AIMessage                                            AIMessage[]
  AssessmentResponse                                   AssessmentResponse[]
  AstroProfile                                         AstroProfile?
  Bouquet                                              Bouquet[]
  ChallengeCompletion                                  ChallengeCompletion[]
  ConsentLog                                           ConsentLog[]
  Couple_Couple_partnerAIdToUser                       Couple?               @relation("Couple_partnerAIdToUser")
  Couple_Couple_partnerBIdToUser                       Couple?               @relation("Couple_partnerBIdToUser")
  CoupleLinkRequest_CoupleLinkRequest_fromUserIdToUser CoupleLinkRequest[]   @relation("CoupleLinkRequest_fromUserIdToUser")
  CoupleLinkRequest_CoupleLinkRequest_toUserIdToUser   CoupleLinkRequest[]   @relation("CoupleLinkRequest_toUserIdToUser")
  MoodStatus                                           MoodStatus?
  MoodEntry                                            MoodEntry[]
  PulseCheckin                                         PulseCheckin[]
  PushSubscription                                     PushSubscription[]
  SmallCraving                                         SmallCraving[]
  City                                                 City?                 @relation(fields: [cityId], references: [id])
  Couple_User_coupleIdToCouple                         Couple?               @relation("User_coupleIdToCouple", fields: [coupleId], references: [id])
  WishlistItem                                         WishlistItem[]
  Flower                                               Flower[]              @relation("FavoriteFlowers")
  Notification                                         Notification[]
  CoupleMessage                                        CoupleMessage[]
  Memory                                               Memory[]
  RitualCompletion                                     RitualCompletion[]
  LetterFrom                                           Letter[]               @relation("LetterFrom")
  LetterTo                                             Letter[]               @relation("LetterTo")
  WarmthEntry                                          WarmthEntry[]

  @@index([coupleId])
  @@index([username])
}

model AIConversation {
  id        String      @id
  userId    String
  title     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime
  User      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  AIMessage AIMessage[]

  @@index([userId])
}

model AIMessage {
  id             String         @id
  conversationId String
  userId         String?
  role           MessageRole
  content        String
  tokensInput    Int?
  tokensOutput   Int?
  model          String?
  createdAt      DateTime       @default(now())
  AIConversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  User           User?          @relation(fields: [userId], references: [id])

  @@index([conversationId])
}

model Assessment {
  id                 String               @id
  key                String               @unique
  title              String
  description        String
  emoji              String?
  radarAxis          String?
  version            Int                  @default(1)
  isActive           Boolean              @default(true)
  order              Int                  @default(0)
  AssessmentResponse AssessmentResponse[]
  Question           Question[]
  CoupleReport       CoupleReport[]       @relation("ReportAssessments")
}

model AssessmentResponse {
  id           String     @id
  userId       String
  assessmentId String
  questionId   String
  answer       Json
  answeredAt   DateTime   @default(now())
  Assessment   Assessment @relation(fields: [assessmentId], references: [id])
  Question     Question   @relation(fields: [questionId], references: [id])
  User         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([assessmentId])
  @@index([userId, assessmentId])
}

model AstroProfile {
  id             String           @id
  userId         String           @unique
  sunSign        String
  moonSign       String
  risingSign     String?
  mercurySign    String
  venusSign      String
  marsSign       String
  jupiterSign    String
  saturnSign     String
  chineseZodiac  String
  chineseElement String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  User           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  PlanetPosition PlanetPosition[]
}

model Bouquet {
  id          String   @id
  userId      String
  name        String
  flowerSlugs String[]
  note        String?
  createdAt   DateTime @default(now())
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Challenge {
  id                  String                @id
  coupleId            String
  weekNumber          Int
  year                Int
  title               String
  description         String
  instruction         String
  examplePhrase       String?
  axis                String
  difficulty          Int
  durationMin         Int
  status              ChallengeStatus       @default(PENDING)
  createdAt           DateTime              @default(now())
  completedAt         DateTime?
  Couple              Couple                @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  ChallengeCompletion ChallengeCompletion[]

  @@unique([coupleId, weekNumber, year])
  @@index([coupleId])
}

model ChallengeCompletion {
  id          String    @id
  challengeId String
  userId      String
  completedAt DateTime  @default(now())
  Challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
}

model DateInvite {
  id          String          @id
  coupleId    String
  createdBy   String
  vibe        String?
  vibeEmoji   String?
  venueId     String?
  venueName   String?
  venueArea   String?
  venueEmoji  String?
  date        String?
  time        String?
  status      InviteStatus    @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  Couple      Couple          @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  @@index([coupleId])
  @@index([status])
}

model MoodEntry {
  id        String   @id
  userId    String
  coupleId  String?
  emoji     String
  text      String?
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([coupleId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  text      String
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model CoupleMessage {
  id        String   @id
  coupleId  String
  senderId  String
  content   String
  createdAt DateTime @default(now())
  Couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([coupleId, createdAt])
}

model DailyQuestion {
  id        String    @id
  coupleId  String
  date      String
  question  String
  answerA   String?
  answerB   String?
  revealed  Boolean   @default(false)
  createdAt DateTime  @default(now())
  Couple    Couple    @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  @@unique([coupleId, date])
  @@index([coupleId, date])
}

model Signal {
  id              String     @id @default(cuid())
  coupleId        String
  emoji           String
  meaning         String
  suggestedReply  String
  ackedAt         DateTime?
  Couple          Couple     @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  @@index([coupleId])
}

model PauseSession {
  id        String   @id @default(cuid())
  coupleId  String   @unique
  startedBy String
  endsAt    DateTime
  active    Boolean  @default(true)
  Couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
}

model WarmthEntry {
  id         String   @id @default(cuid())
  coupleId   String
  fromUserId String
  text       String
  createdAt  DateTime @default(now())
  Couple     Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  User       User     @relation(fields: [fromUserId], references: [id], onDelete: Cascade)

  @@index([coupleId])
}

model CoupleEvent {
  id        String   @id @default(cuid())
  coupleId  String
  type      String
  title     String
  meta      Json?
  createdAt DateTime @default(now())
  Couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  @@index([coupleId, createdAt])
}

model DateMemory {
  id         String   @id @default(cuid())
  coupleId   String
  venueName  String
  date       DateTime
  photoUrl   String?
  note       String?
  createdAt  DateTime @default(now())
  Couple     Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  @@index([coupleId])
}

model Memory {
  id        String   @id
  coupleId  String
  userId    String
  caption   String
  imageUrl  String?
  date      String?
  createdAt DateTime @default(now())
  Couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([coupleId])
  @@index([userId])
}

model Ritual {
  id        String             @id
  coupleId  String
  title     String
  emoji     String
  daysOfWeek Int[]
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())
  Couple    Couple             @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  RitualCompletion RitualCompletion[]

  @@index([coupleId])
}

model RitualCompletion {
  id        String   @id
  ritualId  String
  userId    String
  date      String
  createdAt DateTime @default(now())
  Ritual    Ritual   @relation(fields: [ritualId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ritualId, userId, date])
  @@index([ritualId])
}

model Letter {
  id        String   @id
  coupleId  String
  fromUserId String
  toUserId  String
  title     String
  content   String
  readAt    DateTime?
  createdAt DateTime @default(now())
  Couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  Sender    User     @relation("LetterFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  Recipient User     @relation("LetterTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([coupleId])
  @@index([toUserId])
}

model City {
  id       String  @id
  slug     String  @unique
  name     String
  emoji    String
  timezone String?
  lat      Float?
  lon      Float?
  order    Int     @default(0)
  User     User[]
  Venue    Venue[]

  @@index([name])
}

model ConsentLog {
  id        String   @id
  userId    String
  type      String
  accepted  Boolean  @default(true)
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Couple {
  id                           String           @id
  partnerAId                   String           @unique
  partnerBId                   String           @unique
  status                       CoupleStatus     @default(PENDING)
  startedAt                    DateTime?
  createdAt                    DateTime         @default(now())
  updatedAt                    DateTime
  Challenge                    Challenge[]
  DateInvite                   DateInvite[]
  User_Couple_partnerAIdToUser User             @relation("Couple_partnerAIdToUser", fields: [partnerAId], references: [id])
  User_Couple_partnerBIdToUser User             @relation("Couple_partnerBIdToUser", fields: [partnerBId], references: [id])
  CoupleReport                 CoupleReport[]
  CoupleAnalysis               CoupleAnalysis[]
  SynastryReport               SynastryReport?
  User_User_coupleIdToCouple   User[]           @relation("User_coupleIdToCouple")
  CoupleMessage                CoupleMessage[]
  DailyQuestion                DailyQuestion[]
  Memory                       Memory[]
  Ritual                       Ritual[]
  Letter                       Letter[]
  Signal                       Signal[]
  PauseSession                 PauseSession?
  WarmthEntry                  WarmthEntry[]
  CoupleEvent                  CoupleEvent[]
  DateMemory                   DateMemory[]

  @@unique([partnerAId, partnerBId])
  @@index([status])
}

model CoupleLinkRequest {
  id                                      String            @id
  fromUserId                              String
  toUserId                                String
  status                                  LinkRequestStatus @default(PENDING)
  expiresAt                               DateTime
  createdAt                               DateTime          @default(now())
  updatedAt                               DateTime
  User_CoupleLinkRequest_fromUserIdToUser User              @relation("CoupleLinkRequest_fromUserIdToUser", fields: [fromUserId], references: [id])
  User_CoupleLinkRequest_toUserIdToUser   User              @relation("CoupleLinkRequest_toUserIdToUser", fields: [toUserId], references: [id])

  @@index([fromUserId, status])
  @@index([toUserId, status])
}

model CoupleReport {
  id                 String       @id
  coupleId           String
  version            Int          @default(1)
  radarData          Json
  strongSides        Json
  growthAreas        Json
  recommendations    Json
  constellationState Json
  astroCompatibility Json?
  riskMarkers        Json?
  generatedAt        DateTime     @default(now())
  basedOnAssessments String[]
  Couple             Couple       @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  Assessment         Assessment[] @relation("ReportAssessments")

  @@index([coupleId])
}

model CoupleAnalysis {
  id           String   @id
  coupleId     String
  version      Int      @default(1)
  summary      String
  strengths    Json
  weaknesses   Json
  growthPoints Json
  perspectives String
  breakupRisks Json
  basedOnHash  String
  basedOn      String[]
  createdAt    DateTime @default(now())
  Couple       Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  @@index([coupleId])
}

model Flower {
  id        String  @id
  slug      String  @unique
  name      String
  latinName String?
  emoji     String
  imageUrl  String?
  meaning   String?
  season    String?
  hexColor  String?
  order     Int     @default(0)
  User      User[]  @relation("FavoriteFlowers")
}

model MoodStatus {
  id        String   @id
  userId    String   @unique
  emoji     String
  text      String?
  setAt     DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlanetPosition {
  id             String       @id
  astroProfileId String
  planet         String
  sign           String
  degree         Int
  house          Int?
  retrograde     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  AstroProfile   AstroProfile @relation(fields: [astroProfileId], references: [id], onDelete: Cascade)
}

model PulseCheckin {
  id                 String   @id
  userId             String
  coupleId           String
  weekNumber         Int
  year               Int
  closeness          Int
  conflictResolution Int
  missing            String?
  createdAt          DateTime @default(now())
  User               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekNumber, year])
  @@index([coupleId, weekNumber, year])
}

model PushSubscription {
  id             String    @id
  userId         String
  endpoint       String    @unique
  keysP256dh     String
  keysAuth       String
  userAgent      String?
  createdAt      DateTime  @default(now())
  lastNotifiedAt DateTime?
  User           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Question {
  id                 String               @id
  assessmentId       String
  order              Int
  text               String
  type               QuestionType
  options            Json?
  dimension          String?
  reverseScored      Boolean              @default(false)
  visibleToPartner   Boolean              @default(true)
  isRiskMarker       Boolean              @default(false)
  AssessmentResponse AssessmentResponse[]
  Assessment         Assessment           @relation(fields: [assessmentId], references: [id])
}

model SmallCraving {
  id               String        @id
  userId           String
  item             String
  category         String?
  status           CravingStatus @default(PENDING)
  pickedUpByUserId String?
  pickedUpAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime
  User             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SynastryReport {
  id                   String   @id
  coupleId             String   @unique
  aspects              Json
  elementBalance       Json
  modalityBalance      Json
  sunMoonAspect        Json?
  venusMarsAspect      Json?
  mercuryMercuryAspect Json?
  chineseCompatibility Json
  overallScore         Int
  generatedAt          DateTime @default(now())
  updatedAt            DateTime
  Couple               Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
}

model Venue {
  id             String    @id
  cityId         String
  type           VenueType
  name           String
  description    String?
  emoji          String
  area           String?
  address        String?
  priceLevel     Int       @default(2)
  romantic       Boolean   @default(false)
  recommendation String?
  phone          String?
  bookingUrl     String?
  lat            Float?
  lon            Float?
  order          Int       @default(0)
  createdAt      DateTime  @default(now())
  City           City      @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([cityId])
  @@index([cityId, type])
}

model CommunityVenueRating {
  id        String   @id @default(cuid())
  venueId   String
  userId    String
  rating    Float                          // 1..5
  createdAt DateTime @default(now())
  venue     CommunityVenue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, userId])              // один голос на человека
}

model CommunityVenue {
  id          String   @id @default(cuid())
  cityName    String   // нормализовано: "томск"
  dish        String   // "роллы" | "пицца" | ...
  name        String
  address     String?
  phone       String?
  comment     String?  // 140 символов
  createdBy   String
  createdAt   DateTime @default(now())
  ratings     CommunityVenueRating[]
  picks       Int      @default(0)  // сколько раз выбрали в свиданиях
  reports     Int      @default(0)

  @@unique([cityName, dish, name])          // анти-дубликат
  @@index([cityName, dish])
}

model WishlistItem {
  id         String         @id
  userId     String
  title      String
  link       String?
  imageUrl   String?
  priceRange String?
  urgency    String?
  status     WishlistStatus @default(WANTED)
  giftId     String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime
  User       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ChallengeStatus {
  PENDING
  ACTIVE
  COMPLETED
  EXPIRED
}

enum CoupleStatus {
  PENDING
  ACTIVE
  ARCHIVED
  DELETED
}

enum CravingStatus {
  PENDING
  PICKED_UP
}

enum InviteStatus {
  PENDING
  PROPOSED
  CONFIRMED
  DECLINED
}

enum LinkRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum QuestionType {
  LIKERT_1_5
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TEXT
}

enum VenueType {
  RESTAURANT
  CAFE
  BAR
  PARK
  WALK
  MUSEUM
  CINEMA
  SPA
}

enum WishlistStatus {
  WANTED
  BOUGHT
  LATE
  CANCELED
}
